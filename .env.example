# NIDS Configuration File
# Copy this file to .env and modify the values as needed

# Network Configuration
NIDS_NETWORK_INTERFACE=eth0
NIDS_PACKET_CAPTURE_TIMEOUT=1
NIDS_MAX_PACKETS_PER_BATCH=1000

# Feature Extraction
NIDS_FEATURE_WINDOW_SIZE=100

# ML Model Configuration
NIDS_ANOMALY_THRESHOLD=0.7
NIDS_MODEL_PATH=models/nids_model.pkl

# Alert Configuration
NIDS_ALERT_COOLDOWN=60

# Web Dashboard
NIDS_WEB_PORT=5000

# Logging
NIDS_LOG_LEVEL=INFO
NIDS_MAX_LOG_SIZE=10485760
NIDS_BACKUP_COUNT=5

# Model Types (ensemble, isolation_forest, one_class_svm, local_outlier_factor)
NIDS_MODEL_TYPE=ensemble 